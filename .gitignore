# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# 虚拟环境
.venv/
venv/

# 环境变量（含密钥，勿入库）
.env

# 编辑器
.idea/
.vscode/
.DS_Store

# 前端
web/node_modules/
web/dist/
# tsc 现已设 noEmit（web/tsconfig.json），正常不再向 src 吐编译产物；
# 以下忽略作为兜底，防误配置/旧产物入库（.js 还会 shadow 掉同名 .tsx）
web/tsconfig.tsbuildinfo
web/src/**/*.js
web/src/**/*.js.map
web/src/**/*.d.ts

# 运行时数据（应用启动/测试时生成，非源码）
*.db
*.db-wal
*.db-shm
downloads/

# eval 报告产物（每轮一份，带时间戳）。基线 evals/baselines/ 要进 git —— 它是门禁判据，
# 分数变化必须以 diff 形式出现在 PR 里让人看见。
evals/reports/
