# 交付前校验门（app/verify.py::AnswerVerifier）的准召。case 主体搬自 tests/app/test_verify.py。
# judge_returns 的键是 system prompt 里的关键词：「事实核查」→grounding，「质检」→judge，
# 与 test_verify.py:15 的 _fake_complete 约定一致。
# ⚠️ 带 sut-convention 标签的 case 断言的是「LLM/基建失败 → 放行」这个刻意的线上约定
#    （绝不因抖动拦交付）。它们看起来像 bug，其实是被测对象的正确行为，别"修"掉。
{"id": "format-empty", "kind": "gate", "tags": ["format", "hard"], "input": {"question": "问", "answer": "   ", "judge_returns": {"事实核查": {"grounded": true, "feedback": ""}, "质检": {"score": 95, "feedback": "好"}}}, "expect": {"ok": false, "failed": ["format"]}}
{"id": "format-unclosed-fence", "kind": "gate", "tags": ["format", "hard"], "notes": "代码围栏未闭合 → 大概率被截断", "input": {"question": "问", "answer": "看代码：\n```python\nprint(1)", "judge_returns": {"事实核查": {"grounded": true, "feedback": ""}, "质检": {"score": 95, "feedback": "好"}}}, "expect": {"ok": false, "failed": ["format"]}}
{"id": "all-pass-normal-answer", "kind": "gate", "tags": ["happy"], "input": {"question": "光合作用是什么", "answer": "光合作用是植物把光能转化为化学能的过程。", "config_overrides": {"gate_check_code": false}, "judge_returns": {"事实核查": {"grounded": true, "feedback": ""}, "质检": {"score": 95, "feedback": "好"}}}, "expect": {"ok": true, "failed": []}}
{"id": "grounding-fail-when-unsupported", "kind": "gate", "tags": ["grounding", "soft"], "input": {"question": "问", "answer": "答案含臆造论断。", "grounding": [{"tool": "search_memory", "content": "[1]（来源：a）光合作用相关资料", "is_error": false}], "config_overrides": {"gate_check_code": false}, "judge_returns": {"事实核查": {"grounded": false, "feedback": "X 无依据"}, "质检": {"score": 95, "feedback": ""}}}, "expect": {"ok": false, "failed": ["grounding"]}}
{"id": "grounding-skipped-when-no-retrieval", "kind": "gate", "tags": ["grounding"], "notes": "本轮没有 search_memory 命中 → grounding 整项跳过（N/A 视为通过），假 judge 说 grounded=false 也不该被调用", "input": {"question": "问", "answer": "闲聊回答", "config_overrides": {"gate_check_code": false}, "judge_returns": {"事实核查": {"grounded": false, "feedback": "不该被调用"}, "质检": {"score": 95, "feedback": ""}}}, "expect": {"ok": true, "failed": []}}
{"id": "grounding-skipped-on-no-hit-sentinel", "kind": "gate", "tags": ["grounding"], "notes": "检索到「未命中」哨兵文案 → 视为无资料，同样跳过", "input": {"question": "问", "answer": "答", "grounding": [{"tool": "search_memory", "content": "（未在知识库中检索到相关内容）", "is_error": false}], "config_overrides": {"gate_check_code": false}, "judge_returns": {"事实核查": {"grounded": false, "feedback": "不该被调用"}, "质检": {"score": 95, "feedback": ""}}}, "expect": {"ok": true, "failed": []}}
{"id": "grounding-unsupported-listed-in-critique", "kind": "gate", "tags": ["grounding", "soft"], "input": {"question": "问", "answer": "答", "grounding": [{"tool": "search_memory", "content": "[1] 资料", "is_error": false}], "config_overrides": {"gate_check_code": false}, "judge_returns": {"事实核查": {"grounded": false, "unsupported": ["地球是平的", "水往高处流"], "feedback": ""}, "质检": {"score": 95}}}, "expect": {"ok": false, "failed": ["grounding"]}}
{"id": "judge-low-score-fails", "kind": "gate", "tags": ["judge", "soft"], "input": {"question": "问", "answer": "答", "config_overrides": {"gate_check_code": false, "answer_pass_score": 70}, "judge_returns": {"事实核查": {"grounded": true, "feedback": ""}, "质检": {"score": 40, "feedback": "跑题"}}}, "expect": {"ok": false, "failed": ["judge"]}}
{"id": "judge-score-at-threshold-passes", "kind": "gate", "tags": ["judge", "boundary"], "notes": "边界：等于阈值应通过（判据是 score < pass_score 才不过）", "input": {"question": "问", "answer": "答", "config_overrides": {"gate_check_code": false, "answer_pass_score": 70}, "judge_returns": {"事实核查": {"grounded": true, "feedback": ""}, "质检": {"score": 70, "feedback": "刚好"}}}, "expect": {"ok": true, "failed": []}}
{"id": "code-block-error-fails", "kind": "gate", "tags": ["code", "hard"], "input": {"question": "写段代码", "answer": "如下：\n```python\nprint( SyntaxError here\n```", "config_overrides": {"gate_check_grounding": false, "gate_check_judge": false}, "stub_tools": {"run_python": "fail"}}, "expect": {"ok": false, "failed": ["code"]}}
{"id": "code-block-success-passes", "kind": "gate", "tags": ["code"], "input": {"question": "写段代码", "answer": "如下：\n```python\nprint(1+1)\n```", "config_overrides": {"gate_check_grounding": false, "gate_check_judge": false}, "stub_tools": {"run_python": "ok"}}, "expect": {"ok": true, "failed": []}}
{"id": "code-block-with-ellipsis-skipped", "kind": "gate", "tags": ["code"], "notes": "含省略占位 → 非自包含 → 跳过执行，即便桩工具必失败也不判不过", "input": {"question": "写段代码", "answer": "示例：\n```python\ndef f():\n    ...\n```", "config_overrides": {"gate_check_grounding": false, "gate_check_judge": false}, "stub_tools": {"run_python": "fail"}}, "expect": {"ok": true, "failed": []}}
{"id": "consistency-claims-action-without-tools", "kind": "gate", "tags": ["consistency", "hard"], "notes": "声称已入错题集但本轮零工具调用 → 判不一致（硬门）", "input": {"question": "把这题存进错题集", "answer": "已经帮你把这道题加入错题集了。", "steps": null, "config_overrides": {"gate_check_code": false}, "judge_returns": {"事实核查": {"grounded": true}, "质检": {"score": 95}}}, "expect": {"ok": false, "failed": ["consistency"]}}
{"id": "consistency-ok-when-tool-called", "kind": "gate", "tags": ["consistency"], "notes": "同样的措辞，但本轮真调了工具 → 不判不一致", "input": {"question": "把这题存进错题集", "answer": "已经帮你把这道题加入错题集了。", "steps": [{"tool": "save_wrong_answer", "result": "已保存", "is_error": false}], "config_overrides": {"gate_check_code": false}, "judge_returns": {"事实核查": {"grounded": true}, "质检": {"score": 95}}}, "expect": {"ok": true, "failed": []}}
{"id": "judge-raises-does-not-block", "kind": "gate", "tags": ["regression", "sut-convention"], "notes": "judge 抛异常 → 该项跳过、放行。线上绝不因基建抖动拦交付；这是刻意约定，别修。", "input": {"question": "问", "answer": "正常答案", "config_overrides": {"gate_check_code": false, "gate_check_grounding": false}, "judge_returns": {"质检": "__raise__"}}, "expect": {"ok": true, "failed": []}}
{"id": "judge-bad-json-does-not-block", "kind": "gate", "tags": ["regression", "sut-convention"], "notes": "judge 不吐合法 JSON → 解析失败 → 同样放行", "input": {"question": "问", "answer": "正常答案", "config_overrides": {"gate_check_code": false, "gate_check_grounding": false}, "judge_returns": {"质检": "__bad_json__"}}, "expect": {"ok": true, "failed": []}}
{"id": "grounding-raises-does-not-block", "kind": "gate", "tags": ["regression", "sut-convention"], "notes": "grounding 核查抛异常 → 放行，不因抖动拦交付", "input": {"question": "问", "answer": "答", "grounding": [{"tool": "search_memory", "content": "[1] 资料", "is_error": false}], "config_overrides": {"gate_check_code": false, "gate_check_judge": false}, "judge_returns": {"事实核查": "__raise__"}}, "expect": {"ok": true, "failed": []}}
