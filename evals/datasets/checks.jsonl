# 交付后机械检查（app/verify.py::DeliveryChecker）的准召。case 主体搬自 tests/app/test_verify.py。
# judge_returns 的键是 system prompt 里的关键词：「事实核查」→grounding。
# ⚠️ 带 sut-convention 标签的 case 断言的是「LLM/基建失败 → 静默跳过该项」这个刻意的
#    线上约定（假提醒比不提醒更糟）。它们看起来像 bug，其实是被测对象的正确行为，别"修"掉。
# 注：judge 层随交付门一并删除（它与编排器的 Critic.review 做的是同一件事），
#    故原 judge-* 三条 case 已移除；format 的"空回答"也不再是一条提醒（空产出交由上游报错）。
{"id": "format-unclosed-fence", "kind": "checks", "tags": ["format"], "notes": "代码围栏未闭合 → 大概率被截断", "input": {"answer": "看代码：\n```python\nprint(1)", "judge_returns": {"事实核查": {"grounded": true, "feedback": ""}}, "config_overrides": {}}, "expect": {"notices": ["format"]}}
{"id": "all-pass-normal-answer", "kind": "checks", "tags": ["happy"], "input": {"answer": "光合作用是植物把光能转化为化学能的过程。", "config_overrides": {"delivery_check_code": false}, "judge_returns": {"事实核查": {"grounded": true, "feedback": ""}}}, "expect": {"notices": []}}
{"id": "grounding-fail-when-unsupported", "kind": "checks", "tags": ["grounding"], "input": {"answer": "答案含臆造论断。", "grounding": [{"tool": "search_knowledge", "content": "[1]（来源：a）光合作用相关资料", "is_error": false}], "config_overrides": {"delivery_check_code": false}, "judge_returns": {"事实核查": {"grounded": false, "feedback": "X 无依据"}}}, "expect": {"notices": ["grounding"]}}
{"id": "grounding-skipped-when-no-retrieval", "kind": "checks", "tags": ["grounding"], "notes": "本轮没有 search_knowledge 命中 → grounding 整项跳过（N/A 视为通过），假 judge 说 grounded=false 也不该被调用", "input": {"answer": "闲聊回答", "config_overrides": {"delivery_check_code": false}, "judge_returns": {"事实核查": {"grounded": false, "feedback": "不该被调用"}}}, "expect": {"notices": []}}
{"id": "grounding-skipped-on-no-hit-sentinel", "kind": "checks", "tags": ["grounding"], "notes": "检索到「未命中」哨兵文案 → 视为无资料，同样跳过", "input": {"answer": "答", "grounding": [{"tool": "search_knowledge", "content": "（未在知识库中检索到相关内容）", "is_error": false}], "config_overrides": {"delivery_check_code": false}, "judge_returns": {"事实核查": {"grounded": false, "feedback": "不该被调用"}}}, "expect": {"notices": []}}
{"id": "grounding-unsupported-listed-in-critique", "kind": "checks", "tags": ["grounding"], "input": {"answer": "答", "grounding": [{"tool": "search_knowledge", "content": "[1] 资料", "is_error": false}], "config_overrides": {"delivery_check_code": false}, "judge_returns": {"事实核查": {"grounded": false, "unsupported": ["地球是平的", "水往高处流"], "feedback": ""}}}, "expect": {"notices": ["grounding"]}}
{"id": "code-block-error-fails", "kind": "checks", "tags": ["code"], "input": {"answer": "如下：\n```python\nprint( SyntaxError here\n```", "config_overrides": {"delivery_check_grounding": false, "delivery_check_judge": false}, "stub_tools": {"run_python": "fail"}}, "expect": {"notices": ["code"]}}
{"id": "code-block-success-passes", "kind": "checks", "tags": ["code"], "input": {"answer": "如下：\n```python\nprint(1+1)\n```", "config_overrides": {"delivery_check_grounding": false, "delivery_check_judge": false}, "stub_tools": {"run_python": "ok"}}, "expect": {"notices": []}}
{"id": "code-block-with-ellipsis-skipped", "kind": "checks", "tags": ["code"], "notes": "含省略占位 → 非自包含 → 跳过执行，即便桩工具必失败也不判不过", "input": {"answer": "示例：\n```python\ndef f():\n    ...\n```", "config_overrides": {"delivery_check_grounding": false, "delivery_check_judge": false}, "stub_tools": {"run_python": "fail"}}, "expect": {"notices": []}}
{"id": "grounding-raises-does-not-block", "kind": "checks", "tags": ["regression", "sut-convention"], "notes": "grounding 核查抛异常 → 放行，不因抖动拦交付", "input": {"answer": "答", "grounding": [{"tool": "search_knowledge", "content": "[1] 资料", "is_error": false}], "config_overrides": {"delivery_check_code": false, "delivery_check_judge": false}, "judge_returns": {"事实核查": "__raise__"}}, "expect": {"notices": []}}
