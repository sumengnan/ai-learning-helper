# exam_grader 判分准确率。case 主体搬自 tests/app/test_exam_grader.py，另补充自由文本作答的扩展。
# parsed=null 表示「期望解析不出/有歧义」——线上据此要求用户重答，不判不存不推进。
{"id": "single-letter", "kind": "exam_grade", "tags": ["single"], "input": {"question": {"type": "single", "stem": "光合作用在哪?", "options": ["线粒体", "叶绿体"], "answer": 1}, "user_text": "B"}, "expect": {"parsed": 1, "correct": true}}
{"id": "single-letter-lower", "kind": "exam_grade", "tags": ["single"], "input": {"question": {"type": "single", "stem": "光合作用在哪?", "options": ["线粒体", "叶绿体"], "answer": 1}, "user_text": "b"}, "expect": {"parsed": 1, "correct": true}}
{"id": "single-prefixed", "kind": "exam_grade", "tags": ["single"], "input": {"question": {"type": "single", "stem": "光合作用在哪?", "options": ["线粒体", "叶绿体"], "answer": 1}, "user_text": "选B"}, "expect": {"parsed": 1, "correct": true}}
{"id": "single-ordinal", "kind": "exam_grade", "tags": ["single"], "input": {"question": {"type": "single", "stem": "光合作用在哪?", "options": ["线粒体", "叶绿体"], "answer": 1}, "user_text": "2"}, "expect": {"parsed": 1, "correct": true}}
{"id": "single-option-text", "kind": "exam_grade", "tags": ["single"], "input": {"question": {"type": "single", "stem": "光合作用在哪?", "options": ["线粒体", "叶绿体"], "answer": 1}, "user_text": "叶绿体"}, "expect": {"parsed": 1, "correct": true}}
{"id": "single-letter-and-text", "kind": "exam_grade", "tags": ["single"], "notes": "字母与选项原文都指向同一下标，不算歧义", "input": {"question": {"type": "single", "stem": "光合作用在哪?", "options": ["线粒体", "叶绿体"], "answer": 1}, "user_text": "我觉得是 B 叶绿体"}, "expect": {"parsed": 1, "correct": true}}
{"id": "single-wrong", "kind": "exam_grade", "tags": ["single"], "input": {"question": {"type": "single", "stem": "光合作用在哪?", "options": ["线粒体", "叶绿体"], "answer": 1}, "user_text": "A"}, "expect": {"parsed": 0, "correct": false}}
{"id": "single-ambiguous", "kind": "exam_grade", "tags": ["single", "negative"], "notes": "两个不同下标 → 歧义，不判", "input": {"question": {"type": "single", "stem": "光合作用在哪?", "options": ["线粒体", "叶绿体"], "answer": 1}, "user_text": "AB"}, "expect": {"parsed": null, "correct": null}}
{"id": "single-no-hit", "kind": "exam_grade", "tags": ["single", "negative"], "input": {"question": {"type": "single", "stem": "光合作用在哪?", "options": ["线粒体", "叶绿体"], "answer": 1}, "user_text": "不知道"}, "expect": {"parsed": null, "correct": null}}
{"id": "multi-letters", "kind": "exam_grade", "tags": ["multiple"], "input": {"question": {"type": "multiple", "stem": "选出偶数", "options": ["1", "2", "3", "4"], "answer": [1, 3]}, "user_text": "BD"}, "expect": {"parsed": [1, 3], "correct": true}}
{"id": "multi-ordinals", "kind": "exam_grade", "tags": ["multiple"], "input": {"question": {"type": "multiple", "stem": "选出偶数", "options": ["1", "2", "3", "4"], "answer": [1, 3]}, "user_text": "2、4"}, "expect": {"parsed": [1, 3], "correct": true}}
{"id": "multi-conjunction", "kind": "exam_grade", "tags": ["multiple"], "input": {"question": {"type": "multiple", "stem": "选出偶数", "options": ["1", "2", "3", "4"], "answer": [1, 3]}, "user_text": "B和D"}, "expect": {"parsed": [1, 3], "correct": true}}
{"id": "multi-spaced", "kind": "exam_grade", "tags": ["multiple"], "input": {"question": {"type": "multiple", "stem": "选出偶数", "options": ["1", "2", "3", "4"], "answer": [1, 3]}, "user_text": "选 2 4"}, "expect": {"parsed": [1, 3], "correct": true}}
{"id": "multi-missing-one", "kind": "exam_grade", "tags": ["multiple"], "notes": "少选算错（精确集合比对）", "input": {"question": {"type": "multiple", "stem": "选出偶数", "options": ["1", "2", "3", "4"], "answer": [1, 3]}, "user_text": "B"}, "expect": {"parsed": [1], "correct": false}}
{"id": "multi-extra-one", "kind": "exam_grade", "tags": ["multiple"], "notes": "多选算错", "input": {"question": {"type": "multiple", "stem": "选出偶数", "options": ["1", "2", "3", "4"], "answer": [1, 3]}, "user_text": "BCD"}, "expect": {"parsed": [1, 2, 3], "correct": false}}
{"id": "tf-zh-true", "kind": "exam_grade", "tags": ["truefalse"], "input": {"question": {"type": "truefalse", "stem": "地球是圆的", "options": null, "answer": true}, "user_text": "对"}, "expect": {"parsed": true, "correct": true}}
{"id": "tf-zh-correct", "kind": "exam_grade", "tags": ["truefalse"], "input": {"question": {"type": "truefalse", "stem": "地球是圆的", "options": null, "answer": true}, "user_text": "正确"}, "expect": {"parsed": true, "correct": true}}
{"id": "tf-zh-shide", "kind": "exam_grade", "tags": ["truefalse"], "input": {"question": {"type": "truefalse", "stem": "地球是圆的", "options": null, "answer": true}, "user_text": "是的"}, "expect": {"parsed": true, "correct": true}}
{"id": "tf-check-mark", "kind": "exam_grade", "tags": ["truefalse"], "input": {"question": {"type": "truefalse", "stem": "地球是圆的", "options": null, "answer": true}, "user_text": "√"}, "expect": {"parsed": true, "correct": true}}
{"id": "tf-zh-false", "kind": "exam_grade", "tags": ["truefalse"], "input": {"question": {"type": "truefalse", "stem": "地球是圆的", "options": null, "answer": true}, "user_text": "错"}, "expect": {"parsed": false, "correct": false}}
{"id": "tf-zh-buboi", "kind": "exam_grade", "tags": ["truefalse"], "input": {"question": {"type": "truefalse", "stem": "地球是圆的", "options": null, "answer": true}, "user_text": "不对"}, "expect": {"parsed": false, "correct": false}}
{"id": "tf-cross-mark", "kind": "exam_grade", "tags": ["truefalse"], "input": {"question": {"type": "truefalse", "stem": "地球是圆的", "options": null, "answer": true}, "user_text": "×"}, "expect": {"parsed": false, "correct": false}}
{"id": "tf-en-true", "kind": "exam_grade", "tags": ["truefalse", "regression"], "notes": "回归：曾因整串精确匹配而漏判为 None（见 commit e70cb71）", "input": {"question": {"type": "truefalse", "stem": "地球是圆的", "options": null, "answer": true}, "user_text": "true"}, "expect": {"parsed": true, "correct": true}}
{"id": "tf-en-true-punct", "kind": "exam_grade", "tags": ["truefalse", "regression"], "input": {"question": {"type": "truefalse", "stem": "地球是圆的", "options": null, "answer": true}, "user_text": "true。"}, "expect": {"parsed": true, "correct": true}}
{"id": "tf-en-true-zh-prefix", "kind": "exam_grade", "tags": ["truefalse", "regression"], "input": {"question": {"type": "truefalse", "stem": "地球是圆的", "options": null, "answer": true}, "user_text": "我回答true"}, "expect": {"parsed": true, "correct": true}}
{"id": "tf-en-false-punct", "kind": "exam_grade", "tags": ["truefalse", "regression"], "input": {"question": {"type": "truefalse", "stem": "地球是圆的", "options": null, "answer": true}, "user_text": "false!"}, "expect": {"parsed": false, "correct": false}}
{"id": "tf-en-false-zh-prefix", "kind": "exam_grade", "tags": ["truefalse", "regression"], "input": {"question": {"type": "truefalse", "stem": "地球是圆的", "options": null, "answer": true}, "user_text": "我选false"}, "expect": {"parsed": false, "correct": false}}
{"id": "tf-word-boundary", "kind": "exam_grade", "tags": ["truefalse", "regression", "negative"], "notes": "词内的 true（construe）不应误判", "input": {"question": {"type": "truefalse", "stem": "地球是圆的", "options": null, "answer": true}, "user_text": "construe this"}, "expect": {"parsed": null, "correct": null}}
{"id": "short-correct", "kind": "exam_grade", "tags": ["short"], "input": {"question": {"type": "short", "stem": "什么是光合作用", "answer": "光能转化学能"}, "user_text": "把光能变成化学能", "judge_returns": {"简答题判分员": {"correct": true, "feedback": "要点齐全"}}}, "expect": {"correct": true}}
{"id": "short-wrong", "kind": "exam_grade", "tags": ["short"], "input": {"question": {"type": "short", "stem": "什么是光合作用", "answer": "光能转化学能"}, "user_text": "乱答", "judge_returns": {"简答题判分员": {"correct": false, "feedback": "答非所问"}}}, "expect": {"correct": false}}
{"id": "short-judge-raises-is-conservative", "kind": "exam_grade", "tags": ["short", "regression", "sut-convention"], "notes": "judge 挂了 → 保守判为不算错（宁漏勿误存）。这是 SUT 刻意的线上约定，不是 bug。", "input": {"question": {"type": "short", "stem": "x", "answer": "y"}, "user_text": "z", "judge_returns": {"简答题判分员": "__raise__"}}, "expect": {"correct": true}}
{"id": "short-judge-bad-json-is-conservative", "kind": "exam_grade", "tags": ["short", "regression", "sut-convention"], "notes": "judge 不吐 JSON → 同样保守放行", "input": {"question": {"type": "short", "stem": "x", "answer": "y"}, "user_text": "z", "judge_returns": {"简答题判分员": "__bad_json__"}}, "expect": {"correct": true}}
