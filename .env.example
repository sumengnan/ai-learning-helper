HARNESS_API_KEY=sk-your-key
HARNESS_BASE_URL=https://api.openai.com/v1
HARNESS_MODEL=gpt-4o-mini
HARNESS_MAX_STEPS=10
HARNESS_TEMPERATURE=0.7
# 认证签名密钥（生产必须设置为随机长字符串，勿用默认值）
AUTH_SECRET=change-me-to-a-long-random-secret
# 代码沙箱：docker 后端直连 daemon 的 TLS 端口（不再走 SSH）
# HARNESS_SANDBOX_BACKEND=docker
# HARNESS_SANDBOX_DOCKER_HOST=tcp://your-docker-host:2376
# HARNESS_SANDBOX_DOCKER_TLS_CA_CERT=/path/to/ca.pem
# HARNESS_SANDBOX_DOCKER_TLS_CLIENT_CERT=/path/to/cert.pem
# HARNESS_SANDBOX_DOCKER_TLS_CLIENT_KEY=/path/to/key.pem
# HARNESS_SANDBOX_DOCKER_TLS_VERIFY=true
#
# 无头浏览器（browse 工具）：启用后，若上面的沙箱也启用，抓取会在沙箱容器内跑 Chromium
# （与 http_request 一致的隔离边界）；未配沙箱则回退宿主进程内 Playwright。
# 在沙箱内跑浏览器的前提：
#   1) 镜像须含 Playwright+Chromium（uid 1000 可读）且含 curl——例如
#      mcr.microsoft.com/playwright/python:v1.4x-jammy 基础上 apt-get install -y curl
#   2) 容器根文件系统不能只读，且网络须可出网
#   3) Chromium 多进程，建议放宽内存/进程数上限
# HARNESS_ENABLE_BROWSER=true
# HARNESS_ENABLE_SANDBOX=true
# HARNESS_SANDBOX_IMAGE=your-registry/playwright-python-curl:latest
# HARNESS_SANDBOX_NETWORK=bridge
# HARNESS_SANDBOX_READ_ONLY=false
# HARNESS_SANDBOX_MEM_LIMIT=1g
# HARNESS_SANDBOX_PIDS_LIMIT=256
# 启动参数默认已含 --no-sandbox 等（cap_drop=ALL/非 root/小 shm 下必备），一般无需改
# HARNESS_SANDBOX_BROWSER_LAUNCH_ARGS=["--no-sandbox","--disable-setuid-sandbox","--disable-dev-shm-usage","--disable-gpu"]
