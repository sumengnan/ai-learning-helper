HARNESS_API_KEY=sk-your-key
HARNESS_BASE_URL=https://api.openai.com/v1
HARNESS_MODEL=gpt-4o-mini
HARNESS_MAX_STEPS=10
HARNESS_TEMPERATURE=0.7
# 认证签名密钥（生产必须设置为随机长字符串，勿用默认值）
AUTH_SECRET=change-me-to-a-long-random-secret
# 登录/注册是否强制后端图形验证码校验（生产建议 true）
HARNESS_REQUIRE_CAPTCHA=true
# 检索精排（rerank）：默认关。开启并配好端点+模型后，全局作用于所有检索路径
# （知识库/题库/对话记忆/search_memory），在向量+关键词+MMR 排序之上再做一层精排。
# 端点须为 OpenAI/Cohere/Jina 兼容的 POST {base}/rerank；调用失败自动降级为原序，不打断检索。
# HARNESS_ENABLE_RERANK=true
# HARNESS_RERANK_STYLE=openai        # openai（Cohere/Jina/SiliconFlow 兼容）| dashscope（千问 qwen）
# HARNESS_RERANK_BASE_URL=https://api.siliconflow.cn/v1
# HARNESS_RERANK_API_KEY=            # 留空则回退 EMBEDDING_API_KEY → API_KEY
# HARNESS_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# HARNESS_RERANK_TIMEOUT=30
# HARNESS_RERANK_TOP_N=0             # 0=送全部候选精排；>0 只精排前 N（省调用成本）
# —— 千问 qwen3-rerank（阿里云百炼 DashScope）示例：STYLE=dashscope，BASE_URL 填完整 endpoint ——
# HARNESS_RERANK_STYLE=dashscope
# HARNESS_RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
# HARNESS_RERANK_MODEL=qwen3-rerank
# 代码沙箱：docker 后端直连 daemon 的 TLS 端口（不再走 SSH）
# HARNESS_SANDBOX_BACKEND=docker
# HARNESS_SANDBOX_DOCKER_HOST=tcp://your-docker-host:2376
# HARNESS_SANDBOX_DOCKER_TLS_CA_CERT=/path/to/ca.pem
# HARNESS_SANDBOX_DOCKER_TLS_CLIENT_CERT=/path/to/cert.pem
# HARNESS_SANDBOX_DOCKER_TLS_CLIENT_KEY=/path/to/key.pem
# HARNESS_SANDBOX_DOCKER_TLS_VERIFY=true
#
# 无头浏览器（browse 工具）：启用后，若上面的沙箱也启用，抓取会在沙箱容器内跑 Chromium
# （与 http_request 一致的隔离边界）；未配沙箱则回退宿主进程内 Playwright。
# 在沙箱内跑浏览器的前提：
#   1) 镜像须含 Playwright+Chromium（uid 1000 可读）且含 curl——例如
#      mcr.microsoft.com/playwright/python:v1.4x-jammy 基础上 apt-get install -y curl
#   2) 容器根文件系统不能只读，且网络须可出网
#   3) Chromium 多进程，建议放宽内存/进程数上限
# 推荐：基础镜像保持轻量（如 python:3.12 跑代码），单独给浏览器配 playwright 镜像——
# 设 HARNESS_BROWSER_SANDBOX_IMAGE 后，每次 browse 在该镜像的一次性子沙箱内跑，基础镜像
# 无需装 playwright。留空则复用基础容器（那时基础镜像必须自带 playwright）。
# HARNESS_BROWSER_SANDBOX_IMAGE=mcr.microsoft.com/playwright/python:v1.47.0-jammy
# HARNESS_ENABLE_BROWSER=true
# HARNESS_ENABLE_SANDBOX=true
# http_request 的 User-Agent。空 UA 是最典型的爬虫特征，不少站点据此直接 403；默认按
# 「行为良好的爬虫」惯例如实标明身份（Googlebot 用的也是这个格式）。设为空则不发 UA。
# 这不会绕过 Cloudflare 之类的 bot 检测——那条路本来就走浏览器兜底（ENABLE_BROWSER）。
# HARNESS_HTTP_USER_AGENT=Mozilla/5.0 (compatible; AI-Learning-Helper/1.0; +harness)
#
# 抓取失败网址登记（默认开）：http_request/browse 抓失败的网址会被记下，下次抓前直接跳过
# 并让模型换来源，不再重复撞同一个死链。按失败类型分级，到期自动失效、绝不永久拉黑：
#   超时/连接失败/5xx/429 → 该网址 1 小时；404/410 → 该网址 30 天；
#   401/403 → 整个域名 7 天（反爬通常是整站行为）；抓到空页/拦截页 → 该网址 7 天。
# 登记全局共享（不分用户）：网址抓不抓得到是网站的属性，不是用户的属性。
# HARNESS_ENABLE_URL_BLOCKLIST=false       # 设 false 可关掉，退回「每次都照抓」
# MCP 客户端：开启后按 mcp/mcp_servers.json 连接 MCP server，把远程工具暴露给模型
# （stdio + streamable-http 双传输；改清单后重启或 POST /api/mcp/reload 生效）
# HARNESS_ENABLE_MCP=true
# HARNESS_MCP_CONFIG_PATH=mcp/mcp_servers.json
# HARNESS_MCP_CONNECT_TIMEOUT=15
#
# 联网搜索（阿里云百炼 WebSearch，在 mcp/mcp_servers.json 里 enabled=true）。
# 项目本身没有搜索工具，模型只能猜网址再抓——这个 MCP 补的就是这个缺口。
# 两个都要设，缺一个就静默失效（连接失败只是一条 warning 日志，很容易漏看）：
#   1) 上面的 HARNESS_ENABLE_MCP=true，否则 MCP 客户端根本不连
#   2) DASHSCOPE_API_KEY，否则 mcp/mcp_servers.json 里的 ${DASHSCOPE_API_KEY} 解析不出来，
#      Authorization 头原样发出 "Bearer ${DASHSCOPE_API_KEY}" → 阿里云回 401
# 注意本条不带 HARNESS_ 前缀：它不是配置项，而是给 mcp/mcp_servers.json 的 ${VAR} 用的真环境
# 变量。启动时会把本文件里 os.environ 尚无的键补进去，故写在这里即可；已 export 的优先。
# DASHSCOPE_API_KEY=sk-xxxxxxxx
# 会话基础容器镜像：默认操作（run_shell / 读写文件）在此执行；执行代码/浏览器等则另起子沙箱。
# 推荐轻量 ubuntu 基础镜像 + curl（http_request 用 curl 出网；DNS 解析用 glibc getent，无需
# python3）。例如自建 `FROM ubuntu:24.04; RUN apt-get update && apt-get install -y curl ca-certificates`。
# 注意：默认开启了按语言镜像路由（HARNESS_SANDBOX_IMAGES 有内置 37 项），那时基础容器取的是
# images[默认语言]，SANDBOX_IMAGE 不生效。要让基础=SANDBOX_IMAGE，必须把路由关掉：
#   HARNESS_SANDBOX_IMAGES={}
# HARNESS_SANDBOX_IMAGE=your-registry/ubuntu24-curl:latest
# HARNESS_SANDBOX_IMAGES={}
# HARNESS_SANDBOX_NETWORK=bridge
# HARNESS_SANDBOX_READ_ONLY=false
# HARNESS_SANDBOX_MEM_LIMIT=1g
# HARNESS_SANDBOX_PIDS_LIMIT=256
#
# 按语言/版本的一次性子沙箱：配置后 run_python/run_node/run_java 会按语言[+可选 version]
# 另起一次性子沙箱执行，跑完即销毁、产物回传会话基础容器（会话基础容器 = HARNESS_SANDBOX_IMAGE，
# 建议设为 ubuntu 基础镜像）。key 优先 f"{language}{version}"（回退 language）。
# HARNESS_SANDBOX_LANG_IMAGES={"python":"python:3.12-slim","node":"node:20-slim","java":"eclipse-temurin:21-jdk","java8":"eclipse-temurin:8-jdk","java11":"eclipse-temurin:11-jdk","java17":"eclipse-temurin:17-jdk","java21":"eclipse-temurin:21-jdk"}
# HARNESS_SANDBOX_SUB_NETWORK=none          # 一次性代码子沙箱网络（默认禁网；需 pip/maven 取包时置 bridge）
# 启动参数默认已含 --no-sandbox 等（cap_drop=ALL/非 root/小 shm 下必备），一般无需改
# HARNESS_SANDBOX_BROWSER_LAUNCH_ARGS=["--no-sandbox","--disable-setuid-sandbox","--disable-dev-shm-usage","--disable-gpu"]
#
# 回答交付前校验门：开启后，AI 每轮终稿先经四项校验（格式/知识库grounding/代码可运行/LLM自评打分）
# 再交付；不过则自动带反馈重答，最多 N 次，仍不过则加「⚠️ 未通过校验」告示后交付。
# 代价：末轮不再边生成边逐字流式（缓冲后校验通过再补发终稿），每轮多若干次校验 LLM 调用。
# HARNESS_ENABLE_ANSWER_GATE=false
# HARNESS_ANSWER_GATE_MAX_RETRIES=1        # 校验不过时的自动重答次数（N）；总尝试 = N+1
# HARNESS_ANSWER_PASS_SCORE=70             # LLM 自评打分阈值（低于则不过）
# HARNESS_GATE_CHECK_FORMAT=true           # 分项开关：格式/完整性
# HARNESS_GATE_CHECK_GROUNDING=true        # 分项开关：知识库 grounding（仅当本轮检索到资料时判）
# HARNESS_GATE_CHECK_CODE=true             # 分项开关：代码可运行（需启用沙箱）
# HARNESS_GATE_CHECK_JUDGE=true            # 分项开关：LLM 自评打分
# HARNESS_GATE_CHECK_FACTS=false           # 分项开关：引用链接可达性核对（抓取判 2xx/3xx）
# HARNESS_GATE_CHECK_CONSISTENCY=true      # 分项开关：声称完成保存/入库/下载等动作但本轮零工具调用 → 判不一致、回喂重做
#
# 分布式追踪（OpenTelemetry）。默认关；关时 tracer 为 no-op，零开销。
# 开启后可在追踪后端看 run/step/model_call/tool_call 以及交付门的 answer_gate span
# （属性 app.gate.attempts/retries/ok/degraded，每次尝试一个 verify.attempt event）。
# 注意：交付门判定另有一份结构化记录直接落库（conversation_messages.verify 列），
# 不依赖本开关——即使不开 OTel，也能查「重答几次、哪层没过」。
# HARNESS_OTEL_ENABLED=false
# HARNESS_OTEL_EXPORTER=console            # console（打印到控制台）| otlp
# HARNESS_OTEL_ENDPOINT=                   # otlp 时的 collector 地址，如 http://localhost:4318/v1/traces
#
# 独立 judge 模型（供 grounding/judge/轨迹打分）：留空则复用主模型。
# 用独立/更强模型当裁判，可降低「模型给自己打高分」的偏差。三者独立，可只配 MODEL。
# HARNESS_JUDGE_MODEL=                      # 如 gpt-4o / deepseek-chat；空则回退主 MODEL
# HARNESS_JUDGE_BASE_URL=                   # judge 独立端点；空则回退主 BASE_URL
# HARNESS_JUDGE_API_KEY=                    # judge 独立 key；空则回退主 API_KEY
#
# 「快速模型」档（供压缩/命名/提炼这类机械活）：留空则复用主模型。三者独立，可只配 MODEL。
# 当前三处在用：L2 滚动摘要、对话自动命名、记忆写入的事实提炼（_extract）。
# 这三件事压差了都无害——摘要糙了下轮重压、标题丑了用户改、事实提炼漏了下次再提。
# 刻意不含记忆调和（_reconcile）：那是判断题且后果不可逆（判 REPLACE 会永久作废旧记忆），
# 判错不是省钱是毁数据，故始终走主模型。
# HARNESS_FAST_MODEL=                       # 如 qwen-turbo；空则回退主 MODEL
# HARNESS_FAST_BASE_URL=                    # 快速模型独立端点；空则回退主 BASE_URL
# HARNESS_FAST_API_KEY=                     # 快速模型独立 key；空则回退主 API_KEY
# HARNESS_FAST_ENABLE_THINKING=false        # 默认 false：这些机械活不需要推理链，开着纯烧
#                                           # token 与延迟。⚠️ 即便没配 FAST_MODEL、回退到主
#                                           # 模型，这个开关同样生效（显式发 enable_thinking），
#                                           # 所以不配独立模型也能省下这部分思考开销。
#                                           # 注意聊天页那个「思考模式」开关管不到这些——它只
#                                           # 作用于本轮任务的模型调用，而这些都是旁路调用。
#                                           # 值形式同 LLM_EXTRA_BODY：这里发的是 DashScope
#                                           # 百炼 compatible-mode 的 {"enable_thinking": bool}
#
# 每步正确性校验（实时层，规则为主、无 LLM，默认开）
# HARNESS_ENABLE_STEP_CHECK=true           # 检索空命中/代码执行失败即时标记 + 提示模型自纠正
# HARNESS_STEP_RELEVANCE_MIN=0.0           # 检索低分阈值；0=只判空命中
#
# 轨迹 judge（交付前一次性回看 拆分/关键步/最终 分层打分，与交付门独立可单独开）
# HARNESS_ENABLE_TRAJECTORY_JUDGE=false
# HARNESS_TRAJECTORY_PASS_SCORE=60         # 最终层分数阈值（低于则并入软门重答）
#
# ── 分层上下文管理 ────────────────────────────────────────────────────────────
# 不配则 full：system + 全量历史每轮原样重发。多轮越长 prompt 越大，直到撞模型窗口上限，
# 应用层零保护 —— 长对话务必改用 window 或 layered。
#   full    全量拼接（默认，与历史行为字节级一致）
#   window  仅 L1：按 token 预算的滑动窗口。防爆窗口最省的选项，不产生任何额外 LLM/embedding 开销
#   layered L1 + L2 滚动摘要 + L3 语义检索。注意这是**一个总开关带三条链路**：开了就同时
#           打开「每轮对话入向量库」（1 次 embedding）与「历史被挤出窗口后摘要」（1~2 次 LLM）
# HARNESS_CONTEXT_STRATEGY=full
#
# ⚠️ 下面几个数**务必按你的实际模型改**，默认值是按 128K 窗口写的：
# HARNESS_CONTEXT_WINDOW_TOKENS=128000       # 模型上下文窗口。物理约束：塞不下会报错
# HARNESS_CONTEXT_RESPONSE_RESERVE_TOKENS=4096   # 按模型「最大输出长度」留；思考模型的
#                                                # 思维链也算输出，别只留几 K
# HARNESS_CONTEXT_MAX_PROMPT_TOKENS=0        # 输入总量的**策略**上限，0=不设。与 WINDOW 的
#   # 区别：WINDOW 是「塞不下会报错」，这个是「塞得下但不划算」。分档计价的模型把档位阈值
#   # 填这里（如输入 ≤256K 一个价、超了三倍价 → 填 250000 留点余量）。不设它就只能靠谎报
#   # WINDOW 来控成本，那会让 WINDOW 的含义失真。
# HARNESS_CONTEXT_WORKING_RATIO=0.5          # L1「最近原文」占可用额度的比例。
#   # 注意：剩余部分**不会**被强制留给 L2/L3 —— L2 由 SUMMARY_MAX_TOKENS 单独限（默认才 2000）、
#   # L3 由 RETRIEVAL_TOP_K 条数单独限，两者合计通常只吃几 K。所以这个值调小 = L1 少留原文、
#   # 摘要更早更频繁地触发（每轮都可能调 LLM），多出来的额度多半闲置。想少摘要就往上调（如 0.9）。
# HARNESS_CONTEXT_SUMMARY_MAX_TOKENS=2000    # L2 摘要块上限；超了会再调一次 LLM 压缩
# HARNESS_CONTEXT_RETRIEVAL_TOP_K=5          # L3 召回条数（只召回**本会话**更早的对话片段，
#                                            # 不读知识库）
# HARNESS_CONTEXT_ENABLE_SUMMARY=true        # 仅在 layered 下生效
# HARNESS_CONTEXT_ENABLE_RETRIEVAL=true      # 仅在 layered 下生效；它同时是「对话入向量库」的开关
#
#
# ── 对话记忆的智能写入（SP3）────────────────────────────────────────────────────
# 默认开：把对话提炼成分型事实（semantic/episodic/procedural）再入库；关掉则原文入库。
# 每轮多 2 次 LLM（提炼 + 与既有记忆调和去重/消矛盾），但跑在答案交付之后的后台，不拖慢首字。
# 仅在 CONTEXT_STRATEGY=layered 且 ENABLE_RETRIEVAL=true 时才有对话写入可言。
# ⚠️ 关掉它记忆整合就永远空转：add_texts 写死 SEMANTIC，只有智能写入会产出 episodic，
#    而 MEMORY_CONSOLIDATE_AFTER 的整合只吃 episodic。
# HARNESS_MEMORY_WRITE_EXTRACT=true
# HARNESS_MEMORY_WRITE_SAMPLE_RATE=1.0       # ⚠️ 不是「写不写」的采样，是「走不走智能提炼」：
#                                            # 没抽中的照样原文入库。1.0=全走提炼
# HARNESS_MEMORY_WRITE_CANDIDATE_K=5         # 调和时检索既有记忆的 top-k
#
# ── 记忆整合（SP4）──────────────────────────────────────────────────────────────
# 会话内 episodic 记录数达到此值，就在后台把同主题的零散 episodic 蒸馏成一条 semantic
# （每簇一次 LLM），原 episodic 标记为已废弃。0=关。
# 整合后 episodic 计数回落，故不会每轮重触发；它是 fire-and-forget 的后台任务，
# 不占用本轮 run，不会卡住用户的下一句。
# HARNESS_MEMORY_CONSOLIDATE_AFTER=20
# HARNESS_CONSOLIDATION_SIM_THRESHOLD=0.85   # 贪心聚类的平均余弦阈值
# HARNESS_CONSOLIDATION_MIN_CLUSTER=2        # 成簇最小成员数（不足则不整合该簇）
# HARNESS_CONSOLIDATION_MAX_SOURCE=200       # 单次整合处理的 episodic 上限
