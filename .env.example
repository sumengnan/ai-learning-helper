# ====================================================================================
# AI 学习助手 · 配置参考（.env.example）
# ------------------------------------------------------------------------------------
# 本文件列出全部配置项及其默认值，每项上方一行中文描述。复制为 .env 后按需改值。
# 约定：除 AUTH_SECRET / DASHSCOPE_API_KEY 外，全部以 HARNESS_ 前缀；dict/list 值用 JSON。
# 生产务必改：AUTH_SECRET、HARNESS_API_KEY，并按实际模型调 CONTEXT_* 的几个 token 数。
# ====================================================================================


# ── 模型 / LLM ──────────────────────────────────────────────────────────────────────
# 主模型 API 密钥（默认空，必填才能用）
HARNESS_API_KEY=
# 主模型 API 端点（任意 OpenAI 兼容端点：OpenAI / 千问 Qwen / vLLM 等）
HARNESS_BASE_URL=https://api.openai.com/v1
# 主模型名
HARNESS_MODEL=gpt-4o-mini
# 内核默认 system prompt（应用层聊天另有 HARNESS_APP_SYSTEM_PROMPT 覆盖）
HARNESS_SYSTEM_PROMPT=You are a helpful assistant.
# 单次 run 的最大步数（模型↔工具循环上限，防失控）
HARNESS_MAX_STEPS=100
# 采样温度（0~2，越大越发散）
HARNESS_TEMPERATURE=0.7
# 单次模型请求超时（秒）
HARNESS_REQUEST_TIMEOUT=60.0
# 透传给 chat.completions.create 的额外请求体（JSON）。厂商私有参数用，如自托管 vLLM 关思考：
# {"chat_template_kwargs": {"enable_thinking": false}}。默认空=不改变行为
HARNESS_LLM_EXTRA_BODY={}


# ── 可靠性 / 预算 ────────────────────────────────────────────────────────────────────
# 瞬时错误自动重试次数
HARNESS_MAX_RETRIES=2
# 重试指数退避的基准延迟（秒）
HARNESS_RETRY_BASE_DELAY=0.5
# 单次 run 的 token 预算上限（留空=不限）
HARNESS_MAX_TOKENS_BUDGET=
# 单次 run 的墙钟时间上限（秒，留空=不限）
HARNESS_MAX_WALL_SECONDS=
# 单个工具结果回喂给模型时的字符上限（超出截断）
HARNESS_TOOL_RESULT_MAX_CHARS=100000
# 是否向模型请求 usage 统计（tokens/成本）
HARNESS_INCLUDE_USAGE=true


# ── 可观测（OpenTelemetry）───────────────────────────────────────────────────────────
# 是否启用 OTel 埋点（关=零开销 no-op）
HARNESS_OTEL_ENABLED=false
# 导出方式：console | otlp
HARNESS_OTEL_EXPORTER=console
# otlp 端点（otel_exporter=otlp 时填）
HARNESS_OTEL_ENDPOINT=


# ── 计费 / 成本估算 ──────────────────────────────────────────────────────────────────
# 扁平计费表（JSON）：{model: [输入价/千token, 输出价/千token]}。空=用下面的分层计价
HARNESS_PRICE_MAP={}
# 分层计价（JSON）：每档 [输入上限tokens, 输入价/百万token, 输出价/百万token]，升序、末档封顶。
# 默认按 qwen-plus 档位（¥/百万 token）
HARNESS_MODEL_PRICE_TIERS=[[256000,1.6,6.4],[1000000,4.8,19.2]]
# 成本显示货币符号
HARNESS_PRICE_CURRENCY=¥


# ── 嵌入 / 向量库（embedding）─────────────────────────────────────────────────────────
# embedding 端点（空则回退主 base_url）
HARNESS_EMBEDDING_BASE_URL=https://api.openai.com/v1
# embedding 独立 key（空则回退主 api_key）
HARNESS_EMBEDDING_API_KEY=
# embedding 模型
HARNESS_EMBEDDING_MODEL=text-embedding-3-small
# 向量维度（须与 embedding 模型匹配）
HARNESS_EMBEDDING_DIMENSION=1536
# 向量库文件路径（SQLite + sqlite-vec）
HARNESS_MEMORY_DB_PATH=memory.db
# 默认记忆/知识库集合名
HARNESS_MEMORY_COLLECTION=knowledge


# ── 切块（chunk，入库前把长文切成小块）──────────────────────────────────────────────
# 每块目标字符数
HARNESS_CHUNK_SIZE=1000
# 相邻块重叠字符数（保留上下文连续性）
HARNESS_CHUNK_OVERLAP=200
# 切块硬上限：表格/代码块在此上限内尽量整块保留，绝不超此值
HARNESS_CHUNK_HARD_MAX=2000


# ── 检索（retrieval，RAG 核心管线）────────────────────────────────────────────────────
# 检索默认返回条数
HARNESS_SEARCH_TOP_K=5
# 每路召回的候选池大小
HARNESS_RETRIEVAL_CANDIDATE_POOL=20
# 打分权重：语义相关度
HARNESS_RETRIEVAL_W_RELEVANCE=1.0
# 打分权重：新近度
HARNESS_RETRIEVAL_W_RECENCY=0.2
# 打分权重：重要性
HARNESS_RETRIEVAL_W_IMPORTANCE=0.1
# 新近度指数衰减半衰期（天）
HARNESS_RETRIEVAL_RECENCY_HALF_LIFE_DAYS=30.0
# 是否加关键词检索一路（与向量检索并用）
HARNESS_RETRIEVAL_USE_KEYWORD=true
# 是否做 MMR 去冗余（避免召回一堆几乎相同的片段）
HARNESS_RETRIEVAL_USE_MMR=true
# MMR 的相关性/多样性权衡（0~1，越大越偏相关）
HARNESS_RETRIEVAL_MMR_LAMBDA=0.7
# RRF 融合常数（越大各路名次差异越平）
HARNESS_RETRIEVAL_RRF_K=60
# 召回增强：LLM 从查询抽实体键，精确取该实体记忆（多花一次 LLM）
HARNESS_RETRIEVAL_USE_ENTITY_RECALL=false
# 召回增强：LLM 把查询改写成多条等价查询各跑召回
HARNESS_RETRIEVAL_USE_MULTI_QUERY=false
# 召回增强：LLM 生成假设答案（HyDE）再用其向量召回
HARNESS_RETRIEVAL_USE_HYDE=false
# 多查询改写的条数
HARNESS_RETRIEVAL_MULTI_QUERY_N=3
# 查询规划 LLM 的超时（秒，卡首字关键路径，超时即降级）
HARNESS_RETRIEVAL_QUERY_PLAN_TIMEOUT_S=2.0


# ── 重排（rerank，可选精排）──────────────────────────────────────────────────────────
# 是否启用重排（还需配好端点+模型才生效）
HARNESS_ENABLE_RERANK=false
# 重排接口风格：openai（Cohere/Jina/SiliconFlow 兼容）| dashscope（千问）
HARNESS_RERANK_STYLE=openai
# 重排端点（openai 风格填到 /v1；dashscope 填完整 endpoint）
HARNESS_RERANK_BASE_URL=
# 重排独立 key（空则回退 embedding_api_key → api_key）
HARNESS_RERANK_API_KEY=
# 重排模型（如 BAAI/bge-reranker-v2-m3 或 qwen3-rerank）
HARNESS_RERANK_MODEL=
# 重排请求超时（秒）
HARNESS_RERANK_TIMEOUT=30.0
# 只精排前 N 个候选（0=全部送精排）
HARNESS_RERANK_TOP_N=0


# ── 记忆：智能写入与整合 ─────────────────────────────────────────────────────────────
# 从对话提炼分型事实再入库（关=原文入库）。开着才会产出 episodic、才有整合料源
HARNESS_MEMORY_WRITE_EXTRACT=true
# 智能写入采样率（1.0=每轮都写，0=不写）
HARNESS_MEMORY_WRITE_SAMPLE_RATE=1.0
# 调和时为每条新事实召回的候选记忆条数
HARNESS_MEMORY_WRITE_CANDIDATE_K=5
# 会话情景记忆攒到这么多条就在后台整合成语义记忆；0=关
HARNESS_MEMORY_CONSOLIDATE_AFTER=20
# 各类型记忆保质期（天）；0=永不过期
HARNESS_TTL_EPISODIC_DAYS=0
HARNESS_TTL_SEMANTIC_DAYS=0
HARNESS_TTL_PROCEDURAL_DAYS=0
# 整合聚类的平均余弦相似度阈值
HARNESS_CONSOLIDATION_SIM_THRESHOLD=0.85
# 成簇的最小成员数
HARNESS_CONSOLIDATION_MIN_CLUSTER=2
# 单次整合处理的情景记忆上限
HARNESS_CONSOLIDATION_MAX_SOURCE=200


# ── 情景记忆 ─────────────────────────────────────────────────────────────────────────
# 情景记忆集合名
HARNESS_EPISODE_COLLECTION=episodes
# recall_episodes 默认召回条数
HARNESS_EPISODE_RECALL_K=3


# ── 上下文管理 ───────────────────────────────────────────────────────────────────────
# 策略：full 全量拼接 | window 仅滑动窗口 | layered 窗口+摘要+检索
HARNESS_CONTEXT_STRATEGY=layered
# 模型上下文窗口（物理约束，务必按实际模型改）
HARNESS_CONTEXT_WINDOW_TOKENS=1000000
# 给回复预留的 token（按模型最大输出留；思考模型的思维链也算输出）
HARNESS_CONTEXT_RESPONSE_RESERVE_TOKENS=56000
# 输入总量的策略上限（分档计价时填档位阈值；0=不设，只受物理窗口约束）
HARNESS_CONTEXT_MAX_PROMPT_TOKENS=240000
# L1 最近原文占可用预算的比例（调大=少摘要、多留原文）
HARNESS_CONTEXT_WORKING_RATIO=0.9
# L2 摘要块 token 上限（超了再压一次）
HARNESS_CONTEXT_SUMMARY_MAX_TOKENS=2000
# L3 召回条数（只召回本会话更早的对话片段）
HARNESS_CONTEXT_RETRIEVAL_TOP_K=5
# layered 下是否启用 L2 摘要
HARNESS_CONTEXT_ENABLE_SUMMARY=true
# layered 下是否启用 L3 检索（同时是「对话入向量库」的开关）
HARNESS_CONTEXT_ENABLE_RETRIEVAL=true


# ── 容器沙箱（跑代码/命令；需 HARNESS_ENABLE_SANDBOX=true 才生效）──────────────────────
# 后端：local | docker
HARNESS_SANDBOX_BACKEND=local
# Docker daemon TLS 端口（如 tcp://host:2376）
HARNESS_SANDBOX_DOCKER_HOST=
# 直连 Docker daemon 的双向 TLS 证书
HARNESS_SANDBOX_DOCKER_TLS_CA_CERT=
HARNESS_SANDBOX_DOCKER_TLS_CLIENT_CERT=
HARNESS_SANDBOX_DOCKER_TLS_CLIENT_KEY=
# 是否校验服务端证书
HARNESS_SANDBOX_DOCKER_TLS_VERIFY=true
# 基础容器镜像（默认操作 run_shell/读写文件在此执行；路由未启用时也是代码容器）
HARNESS_SANDBOX_IMAGE=quay.io/centos/centos:stream9
# 语言→镜像路由（JSON）；{} = 不路由，一切用 SANDBOX_IMAGE
HARNESS_SANDBOX_IMAGES={}
# 协议方法（shell/fs）委托到的容器语言
HARNESS_SANDBOX_DEFAULT_LANGUAGE=python
# 按语言[+版本]的一次性代码子沙箱镜像（JSON）：run_python/node/java 会据此另起子沙箱执行
HARNESS_SANDBOX_LANG_IMAGES={"python":"python:3.12-slim","node":"node:20-slim","java":"eclipse-temurin:21-jdk","java8":"eclipse-temurin:8-jdk","java11":"eclipse-temurin:11-jdk","java17":"eclipse-temurin:17-jdk","java21":"eclipse-temurin:21-jdk"}
# 一次性代码子沙箱的网络（默认禁网；需 pip/maven 取包时置 bridge）
HARNESS_SANDBOX_SUB_NETWORK=none
# 危险命令人工确认超时（秒），超时自动拒绝
HARNESS_SANDBOX_APPROVAL_TIMEOUT=120.0
# 容器内工作目录
HARNESS_SANDBOX_WORKSPACE=/workspace
# 容器内运行用户（uid:gid）
HARNESS_SANDBOX_USER=1000:1000
# 基础容器网络：none | bridge
HARNESS_SANDBOX_NETWORK=bridge
# 基础容器内存上限
HARNESS_SANDBOX_MEM_LIMIT=100m
# 基础容器 CPU 上限（核）
HARNESS_SANDBOX_CPUS=1.0
# 基础容器进程数上限
HARNESS_SANDBOX_PIDS_LIMIT=128
# 容器根文件系统是否只读
HARNESS_SANDBOX_READ_ONLY=false
# 单次代码/命令执行超时（秒）
HARNESS_SANDBOX_EXEC_TIMEOUT=30.0
# 代码/命令输出字符上限
HARNESS_SANDBOX_OUTPUT_MAX_CHARS=8000
# 会话级沙箱空闲驱逐（秒）：超时无操作则销毁其容器；<=0 关闭
HARNESS_SANDBOX_IDLE_TIMEOUT=1800.0


# ── 外部 HTTP（联网 http_request 工具）─────────────────────────────────────────────────
# 允许访问的域名白名单（JSON 数组）；[] = 放行公网
HARNESS_HTTP_ALLOWED_DOMAINS=[]
# 是否拦截内网/元数据地址（防 SSRF）
HARNESS_HTTP_BLOCK_PRIVATE=true
# 请求超时（秒）
HARNESS_HTTP_TIMEOUT=30.0
# 响应体大小上限（字节）
HARNESS_HTTP_MAX_RESPONSE_BYTES=10_000_000
# 最大重定向次数
HARNESS_HTTP_MAX_REDIRECTS=5
# User-Agent（空则不发 UA，易被部分站点 403）
HARNESS_HTTP_USER_AGENT=Mozilla/5.0 (compatible; AI-Learning-Helper/1.0; +harness)


# ── 浏览器（无头抓取；需 HARNESS_ENABLE_BROWSER=true）───────────────────────────────────
# 是否无头运行
HARNESS_BROWSER_HEADLESS=true
# 页面导航超时（秒）
HARNESS_BROWSER_NAV_TIMEOUT=30.0
# 等待时机：load | domcontentloaded | networkidle
HARNESS_BROWSER_WAIT_UNTIL=networkidle
# 抓取正文字符上限
HARNESS_BROWSER_OUTPUT_MAX_CHARS=8000
# 浏览器 User-Agent（空=用 Playwright 默认）
HARNESS_BROWSER_USER_AGENT=
# 浏览器专用沙箱镜像（含 Playwright+Chromium+curl）；空则复用基础容器
HARNESS_BROWSER_SANDBOX_IMAGE=ai-learning-helper/playwright-py:v1.47.0
# 浏览器子沙箱内存上限（Chromium 吃内存，别用基础容器的小额度）
HARNESS_BROWSER_SANDBOX_MEM_LIMIT=1g
# 沙箱内跑 Chromium 的启动参数（JSON 数组）
HARNESS_SANDBOX_BROWSER_LAUNCH_ARGS=["--no-sandbox","--disable-setuid-sandbox","--disable-dev-shm-usage","--disable-gpu"]


# ── 技能（渐进式披露；需 HARNESS_ENABLE_SKILLS=true）────────────────────────────────────
# 技能目录：<skills_dir>/<name>/SKILL.md
HARNESS_SKILLS_DIR=skills
# read_skill_resource 单次读取字符上限
HARNESS_SKILL_RESOURCE_MAX_CHARS=8000


# ── 多智能体编排（需 HARNESS_ENABLE_DISPATCH=true）──────────────────────────────────────
# 子 agent 花名册目录：<agents_dir>/<name>.yaml
HARNESS_AGENTS_DIR=agents
# agent 树最大层数（防无限递归）
HARNESS_MAX_DISPATCH_DEPTH=2
# 子 agent 单次 run 步数上限
HARNESS_SUB_AGENT_MAX_STEPS=100


# ── 持久化 ───────────────────────────────────────────────────────────────────────────
# 检查点/轨迹库文件路径
HARNESS_PERSISTENCE_DB_PATH=harness.db


# ── MCP 客户端（需 HARNESS_ENABLE_MCP=true）─────────────────────────────────────────────
# server 清单文件路径（stdio + streamable-http 双传输）
HARNESS_MCP_CONFIG_PATH=mcp/mcp_servers.json
# 单 server 连接/初始化超时（秒）
HARNESS_MCP_CONNECT_TIMEOUT=15.0


# ====================================================================================
# 以下为应用层（app/）配置
# ====================================================================================

# ── 服务与认证 ───────────────────────────────────────────────────────────────────────
# API 监听地址
HARNESS_APP_HOST=127.0.0.1
# API 监听端口
HARNESS_APP_PORT=8000
# 认证签名密钥（不带 HARNESS_ 前缀！默认为不安全占位，生产必须改成随机长串）
AUTH_SECRET=dev-insecure-secret-change-me
# 登录/注册是否强制后端图形验证码（生产建议 true）
HARNESS_REQUIRE_CAPTCHA=false
# 应用业务数据库文件（用户/会话/题库/错题等）
HARNESS_APP_DB_PATH=app.db
# 聊天页的 system prompt
HARNESS_APP_SYSTEM_PROMPT=你是一个 AI 学习助手，可用工具检索知识、联网、计算来帮助用户学习。
# 前端跨域白名单（JSON 数组）
HARNESS_CORS_ORIGINS=["http://localhost:5173"]


# ── 能力总开关 ───────────────────────────────────────────────────────────────────────
# 无头浏览器抓取
HARNESS_ENABLE_BROWSER=false
# 代码沙箱（还需配 SANDBOX_DOCKER_HOST）
HARNESS_ENABLE_SANDBOX=false
# 多智能体派发
HARNESS_ENABLE_DISPATCH=false
# 技能框架
HARNESS_ENABLE_SKILLS=false
# MCP 客户端
HARNESS_ENABLE_MCP=false
# 抓取失败网址登记（下次抓前短路，分级 TTL）
HARNESS_ENABLE_URL_BLOCKLIST=true


# ── 上传 / 知识库 / 题库 ─────────────────────────────────────────────────────────────
# 单文件上传上限（MB）
HARNESS_APP_MAX_UPLOAD_MB=20
# 题库导入：单块字符数（越小块越多、并行度越高）
HARNESS_IMPORT_CHUNK_CHARS=1800
# 题库导入：LLM 抽取并发上限（防打爆单端点触发重试）
HARNESS_IMPORT_MAX_CONCURRENCY=4
# 单次出题最大题数
HARNESS_QUIZ_MAX_COUNT=20
# 出题时检索的知识片段条数
HARNESS_QUIZ_RETRIEVE_K=6
# 简答题判分及格分
HARNESS_SHORT_PASS_SCORE=60


# ── 附件 / 下载 ──────────────────────────────────────────────────────────────────────
# 聊天附件落盘目录
HARNESS_ATTACHMENTS_DIR=attachments
# 单个附件上限（MB）
HARNESS_ATTACHMENT_MAX_MB=100
# 单会话待发附件数量上限
HARNESS_ATTACHMENT_MAX_COUNT=10
# 可直接喂视觉模型的图片附件上限（MB）
HARNESS_ATTACHMENT_VISION_MAX_MB=5
# AI 生成文件的落盘目录
HARNESS_DOWNLOADS_DIR=downloads
# 单个下载产物上限（MB）
HARNESS_DOWNLOAD_MAX_MB=25


# ── 回答校验门 / 每步校验 / 轨迹 judge ─────────────────────────────────────────────────
# 回答校验门总开关（默认关，保持直通流式）
HARNESS_ENABLE_ANSWER_GATE=false
# 不过时的自动重答次数 N（总尝试 N+1）
HARNESS_ANSWER_GATE_MAX_RETRIES=1
# 质量评分阈值（低于则不过）
HARNESS_ANSWER_PASS_SCORE=60
# 分项开关：格式/完整性
HARNESS_GATE_CHECK_FORMAT=true
# 分项开关：知识库 grounding
HARNESS_GATE_CHECK_GROUNDING=true
# 分项开关：代码可运行
HARNESS_GATE_CHECK_CODE=true
# 分项开关：LLM 自评打分
HARNESS_GATE_CHECK_JUDGE=true
# 分项开关：引用链接可达性
HARNESS_GATE_CHECK_FACTS=false
# 高风险步实时校验（检索相关性/代码执行）
HARNESS_ENABLE_STEP_CHECK=true
# 检索低分阈值；0=只判空命中
HARNESS_STEP_RELEVANCE_MIN=0.0
# 轨迹 judge（交付前回看整轨迹分层打分，可单独开）
HARNESS_ENABLE_TRAJECTORY_JUDGE=false
# 轨迹最终层分数阈值
HARNESS_TRAJECTORY_PASS_SCORE=60


# ── 模型分档：judge 档 / 快速档（空则回退主模型）────────────────────────────────────────
# 独立 judge 模型（用更强/独立模型当裁判，降低自评打高分偏差）
HARNESS_JUDGE_MODEL=
# judge 独立端点
HARNESS_JUDGE_BASE_URL=
# judge 独立 key
HARNESS_JUDGE_API_KEY=
# judge 多次取多数（预留，起步 1）
HARNESS_JUDGE_SAMPLES=1
# 快速档模型（压缩/命名/提炼/导入解析等机械活用；恒关思考链）
HARNESS_FAST_MODEL=
# 快速档独立端点
HARNESS_FAST_BASE_URL=
# 快速档独立 key
HARNESS_FAST_API_KEY=


# ── 非 HARNESS_ 前缀：给 mcp/mcp_servers.json 的 ${VAR} 用的真环境变量 ────────────────────
# 阿里云百炼 key（联网搜索 MCP 用）。需同时 HARNESS_ENABLE_MCP=true，否则静默失效
DASHSCOPE_API_KEY=
